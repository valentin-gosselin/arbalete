{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.6.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Valentin Gosselin",
  "browser_specific_settings": {
    "gecko": {
      "id": "arbalete@gosselin.pro",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/arbalete.svg",
    "96": "icons/arbalete.svg"
  },
  "permissions": [
    "tabs",
    "tabHide",
    "sessions",
    "storage",
    "cookies",
    "contextualIdentities",
    "clipboardWrite",
    "menus",
    "menus.overrideContext",
    "tabGroups",
    "search",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Arbalète",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/arbalete.svg",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSidebar__"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "__MSG_cmdPalette__"
    },
    "space-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_cmdSpace1__"
    },
    "space-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_cmdSpace2__"
    },
    "space-3": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "__MSG_cmdSpace3__"
    },
    "space-4": {
      "suggested_key": {
        "default": "Alt+4"
      },
      "description": "__MSG_cmdSpace4__"
    },
    "space-5": {
      "suggested_key": {
        "default": "Alt+5"
      },
      "description": "__MSG_cmdSpace5__"
    },
    "space-next": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_cmdSpaceNext__"
    },
    "space-prev": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_cmdSpacePrev__"
    },
    "move-tab-next": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "__MSG_cmdMoveTabNext__"
    },
    "move-tab-prev": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "__MSG_cmdMoveTabPrev__"
    },
    "favorite-1": {
      "description": "__MSG_cmdFavorite1__"
    },
    "favorite-2": {
      "description": "__MSG_cmdFavorite2__"
    },
    "favorite-3": {
      "description": "__MSG_cmdFavorite3__"
    },
    "favorite-4": {
      "description": "__MSG_cmdFavorite4__"
    },
    "favorite-5": {
      "description": "__MSG_cmdFavorite5__"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdCopyUrl__"
    }
  },
  "optional_permissions": [
    "webRequest",
    "webRequestBlocking",
    "browsingData",
    "history",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": "icons/arbalete.svg",
    "default_title": "__MSG_paletteTitle__",
    "default_popup": "palette/palette.html?panel=1"
  },
  "web_accessible_resources": [
    "palette/palette.html",
    "palette/palette.css",
    "palette/palette.js",
    "icons/lucide.svg"
  ]
}
