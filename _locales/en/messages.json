  "setupManualSummary": {
    "message": "Manual setup (without the script)"
  },
  "setupManual1": {
    "message": "In about:config, set toolkit.legacyUserProfileCustomizations.stylesheets to true."
  },
  "setupManual2": {
    "message": "In about:support, on the \"Profile Folder\" row, click \"Open Folder\"."
  },
  "setupManual3": {
