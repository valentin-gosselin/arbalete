  "setupIntro": {
    "message": "Firefox does not let extensions hide its own tabs. A small customization file (userChrome.css) does it once and for all, without administrator rights. Firefox's tabs are only hidden while the Arbalète sidebar is open."
  },
  "setupHint": {
    "message": "Afterwards, \"Expand the sidebar on hover\" is set in the Arbalète settings."
  },
  "setupDownloadScript": {
    "message": "Download the installer (Windows)"
  },
  "setupStep1": {
    "message": "Open the downloaded file. If Windows shows \"Windows protected your PC\", click \"More info\" then \"Run anyway\"."
  },
  "setupStep2": {
    "message": "Close Firefox completely, then start it again."
  },
  "setupRepeat": {
    "message": "Do it once on each computer. Running the installer again simply updates the configuration."
  },
  "setupDownloadScriptUnix": {
    "message": "Download the installer (Linux, macOS)"
  },
  "setupUnixStep1": {
    "message": "Open a terminal and run:"
  },
  "setupUnixDrag": {
    "message": "Saved it elsewhere? Type sh followed by a space, drag the file into the terminal, then press Enter."
  },
  "setupUnixCommandHint": {
    "message": "Run it in a terminal: sh installer-arbalete.sh"
  },
