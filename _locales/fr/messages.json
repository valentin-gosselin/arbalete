  "setupManualSummary": {
    "message": "Installation manuelle (Mac, Linux, ou sans script)"
  },
  "setupManual1": {
    "message": "Dans about:config, passer toolkit.legacyUserProfileCustomizations.stylesheets à true."
  },
  "setupManual2": {
    "message": "Dans about:support, ligne « Dossier du profil », cliquer « Ouvrir le dossier »."
  },
  "setupManual3": {
    "message": "Y créer un dossier chrome et y mettre le fichier ci-dessous, nommé userChrome.css."
